{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
                { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
                { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https://br-noisy-credit-b4uasm02.storage.c-6.us-east-2.aws.neon.tech; connect-src https://podogest-backend.onrender.com; frame-src https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                { "key": "Content-Type", "value": "application/manifest+json" },
                { "key": "Cache-Control", "value": "no-cache" },
                { "key": "X-Robots-Tag", "value": "noindex" }
            ]
        },
        {
            "source": "/(login|dashboard)",
            "headers": [
                { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
